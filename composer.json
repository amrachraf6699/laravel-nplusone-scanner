{
    "name": "amrachraf6699/laravel-nplusone-scanner",
    "description": "A conservative static analyzer for potential Laravel N+1 query patterns.",
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "Amr Achraf", "email": "amrachraf6690@icloud.com"}],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^7.2|^8.0",
        "symfony/finder": "^7.2|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {"psr-4": {"Amrachraf6699\\LaravelNPlusOneScanner\\": "src/"}},
    "autoload-dev": {"psr-4": {"Amrachraf6699\\LaravelNPlusOneScanner\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["Amrachraf6699\\LaravelNPlusOneScanner\\NPlusOneServiceProvider"]}},
    "scripts": {"test": "phpunit", "lint": "phpcs --standard=PSR12 --warning-severity=0 src tests", "composer-check": "composer validate --strict"},
    "minimum-stability": "stable",
    "prefer-stable": true
}
